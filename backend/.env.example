PORT=8080
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173   # comma-separated frontend origins, or *

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=1234
DB_NAME=bookleaf
DB_HOST=localhost
DB_PORT=5432
DB_SSL=false

# Auth (use a long random string: openssl rand -hex 32)
JWT_SECRET=Bookleafassignment
JWT_EXPIRES_IN=8h

# AI (server-side only). Leave key empty to run without AI (rule-based classification, manual replies).
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_PREGENERATE_DRAFT=true

# On boot: create tables and seed demo data if the database is empty
AUTO_SETUP=true
